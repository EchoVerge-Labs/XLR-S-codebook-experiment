{
 "experiment": "Experiment B - multilingual seen/unseen sweep",
 "checkpoints": {
  "xlsr53": "facebook/wav2vec2-large-xlsr-53",
  "xlsr300m": "facebook/wav2vec2-xls-r-300m"
 },
 "dataset": {
  "name": "google/fleurs",
  "split": "test",
  "languages": 19,
  "clips_per_language": 500,
  "sampling_seed": 1234,
  "total_clips": 9500
 },
 "measurement": {
  "source": "imported verbatim from Stage_A_Diagnostic",
  "mask_prob": 0.065,
  "mask_span": 10,
  "n_negatives": 100,
  "temperature": 0.1,
  "max_seconds": 30.0,
  "repeats_per_file": 3,
  "mask_seed_formula": "1000*file_id + repeat_index",
  "dtype": "bfloat16",
  "energy_gate": "rms > 0.10 * per-file p90(rms)"
 },
 "arms": {
  "full": {
   "crop_seconds": null,
   "role": "PRIMARY OVERALL (unmodified Stage A protocol)"
  },
  "crop6": {
   "crop_seconds": 6.0,
   "role": "PRIMARY CROPPED (matched context, low differential loss)"
  },
  "crop9": {
   "crop_seconds": 9.0,
   "role": "SENSITIVITY (pre-registered P25 rule)"
  }
 },
 "crop_rule": {
  "percentile": 25,
  "round_to": 0.5,
  "windows": [
   6.0,
   9.0
  ],
  "primary": 6.0,
  "short_clips": "dropped, not padded"
 },
